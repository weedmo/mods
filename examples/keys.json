{
  "global": {
    "alt-1": "space.select:1",
    "alt-2": "space.select:2",
    "alt-3": "space.select:3",
    "alt-4": "space.select:4",
    "alt-5": "space.select:5",
    "alt-6": "space.select:6",
    "alt-7": "space.select:7",
    "alt-8": "space.select:8",
    "alt-9": "space.select:9",
    "alt-h": "pane.go:left",
    "alt-j": "pane.go:down",
    "alt-k": "pane.go:up",
    "alt-l": "pane.go:right",
    "alt-left": "pane.go:left",
    "alt-right": "pane.go:right",
    "alt-shift-h": "pane.swap:left",
    "alt-shift-j": "pane.swap:down",
    "alt-shift-k": "pane.swap:up",
    "alt-shift-l": "pane.swap:right",
    "ctrl-+": "app.zoom_in",
    "ctrl--": "app.zoom_out",
    "ctrl-0": "app.zoom_reset",
    "ctrl-=": "app.zoom_in",
    "ctrl-1": "tab.select:1",
    "ctrl-2": "tab.select:2",
    "ctrl-3": "tab.select:3",
    "ctrl-4": "tab.select:4",
    "ctrl-5": "tab.select:5",
    "ctrl-6": "tab.select:6",
    "ctrl-7": "tab.select:7",
    "ctrl-8": "tab.select:8",
    "ctrl-9": "tab.select:9",
    "ctrl-pagedown": "tab.next",
    "ctrl-pageup": "tab.prev",
    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "alt-]": "tab.next",
    "alt-[": "tab.prev",
    "ctrl-shift-pagedown": "space.next",
    "ctrl-shift-pageup": "space.prev",
    "alt-down": "agent.next",
    "alt-up": "agent.prev",
    "ctrl-?": "app.help",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help",
    "ctrl-shift-b": "layout.toggle:sidebar",
    "ctrl-shift-n": "space.new",
    "ctrl-shift-t": "tab.new",
    "ctrl-shift-k": "mod.open:picker",
    "ctrl-shift-p": "app.palette",
    "ctrl-,": "mod.open:settings-weed",
    "ctrl-shift-o": "pane.split:right",
    "ctrl-shift-e": "pane.split:down",
    "ctrl-shift-w": "tab.close",
    "ctrl-shift-x": "pane.close",
    "ctrl-shift-z": "pane.zoom",
    "ctrl-shift-l": "layout.switch",
    "f2": "tab.rename",
    "shift-f2": "space.rename",
    "ctrl-shift-r": "mod.open:agent-resume",
    "ctrl-alt-k": "mod.open:keymap",
    "ctrl-alt-o": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "claude",
          "--dangerously-skip-permissions"
        ]
      }
    },
    "ctrl-alt-e": {
      "command": "pane.split",
      "args": {
        "direction": "down",
        "argv": [
          "claude",
          "--dangerously-skip-permissions"
        ]
      }
    },
    "ctrl-alt-shift-o": {
      "command": "pane.split",
      "args": {
        "direction": "right",
        "argv": [
          "codex",
          "--dangerously-bypass-approvals-and-sandbox"
        ]
      }
    },
    "ctrl-alt-shift-e": {
      "command": "pane.split",
      "args": {
        "direction": "down",
        "argv": [
          "codex",
          "--dangerously-bypass-approvals-and-sandbox"
        ]
      }
    },
    "alt-shift-t": "tabs-weed.detach",
    "alt-shift-right": "tabs-weed.pull-right",
    "alt-shift-left": "tabs-weed.pull-left",
    "alt-shift-down": "tabs-weed.pull-down",
    "alt-shift-up": "tabs-weed.pull-up",
    "ctrl-shift-up": "space.prev",
    "ctrl-shift-down": "space.next",
    "ctrl-shift-left": "tab.prev",
    "ctrl-shift-right": "tab.next",
    "ctrl-alt-c": {
      "command": "tab.new",
      "args": {
        "argv": [
          "claude",
          "--dangerously-skip-permissions"
        ]
      }
    },
    "ctrl-alt-x": {
      "command": "tab.new",
      "args": {
        "argv": [
          "codex",
          "--dangerously-bypass-approvals-and-sandbox"
        ]
      }
    },
    "ctrl-shift-h": "mod.open:sessions-weed",
    "ctrl-shift-g": "tabs-weed.panel-workflow",
    "ctrl-alt-up": "agent.prev",
    "ctrl-alt-down": "agent.next"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-shift-f": "terminal.search",
    "ctrl-v": "terminal.paste_image",
    "ctrl-insert": "terminal.copy",
    "shift-insert": "terminal.paste"
  },
  "layout:main-weed": {
    "ctrl-shift-pagedown": "space-folders.next",
    "ctrl-shift-pageup": "space-folders.prev",
    "ctrl-shift-up": "space-folders.prev",
    "ctrl-shift-down": "space-folders.next"
  }
}
