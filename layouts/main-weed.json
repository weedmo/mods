{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-folders"
              },
              "size": {
                "weight": 1.4
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-weed"
              },
              "size": {
                "weight": 0.8
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tab-bar",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "window_drag": true,
              "content": {
                "mod": "tabs-weed"
              }
            },
            {
              "id": "issues-button",
              "type": "block",
              "size": {
                "px": 112
              },
              "window_drag": true,
              "content": {
                "mod": "projects",
                "props": {
                  "mode": "toolbar"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-weed"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "reviewer"
                      }
                    },
                    {
                      "id": "issues",
                      "type": "block",
                      "content": {
                        "mod": "issues-projects"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "type": "row",
          "id": "status",
          "size": {
            "px": 28
          },
          "resizable": false,
          "children": [
            {
              "type": "block",
              "id": "status-usage",
              "size": {
                "px": 380
              },
              "content": {
                "mod": "usage-weed"
              }
            },
            {
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "id": "status-main"
            }
          ]
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "menu-weed"
}